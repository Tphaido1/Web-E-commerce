# Absolute URL to the backend REST API, including its version prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Hosting production: replace this with your actual public HTTPS backend URL.
# Vercel/Netlify run build:deploy and reject local/example/missing endpoints.
# VITE_API_BASE_URL=https://YOUR-DEPLOYED-BACKEND/api/v1

# Socket.io server origin. Defaults to the origin parsed from VITE_API_BASE_URL.
# Set this when the websocket endpoint is hosted at a different origin.
# VITE_SOCKET_URL=https://api.example.com
