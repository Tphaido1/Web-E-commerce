{
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error", "log"] }]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      },
      "globals": {
        "__ENV": "readonly",
        "__VU": "readonly",
        "__ITER": "readonly"
      }
    }
  ]
}
