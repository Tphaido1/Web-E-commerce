# ==========================================
# ENVIRONMENT VARIABLES - ECOMMERCE SERVER
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit file .env lên Git.
# ==========================================

# Cổng chạy server
PORT=5000

# Môi trường chạy: development | production | test
NODE_ENV=development

# Chuỗi kết nối MongoDB (local hoặc Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Khóa bí mật dùng để ký JWT (nên dùng chuỗi ngẫu nhiên dài, phức tạp khi deploy)
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_me
JWT_REFRESH_EXPIRES_IN=30d

# URL của các Client (dùng để cấu hình CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Khóa bí mật HMAC-SHA256 tạo mã QR hóa đơn và Token chống giả mạo đơn hàng (Tuần 4)
HMAC_SECRET=your_super_secret_hmac_key_for_order_qr

# Cổng thanh toán VNPay Sandbox (Tuần 5)
VNP_TMN_CODE=2QXUI4J4
VNP_HASH_SECRET=RAHZANVOWZGCLUTNZJNXGUSYDJAEXMGS
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/checkout/payment-result
