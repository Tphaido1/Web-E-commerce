# ==============================================================================
# ENVIRONMENT VARIABLES - ECOMMERCE SERVER (TUẦN 1 - TUẦN 6)
# ==============================================================================
# Copy file này thành .env và điền các giá trị thực tế của bạn.
# LƯU Ý: KHÔNG commit file .env chứa thông tin bí mật lên Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & CƠ SỞ DỮ LIỆU (TUẦN 1)
# ------------------------------------------------------------------------------
# Cổng chạy ứng dụng Backend Express
PORT=5000

# Môi trường thực thi: development | production | test
NODE_ENV=development

# Chuỗi kết nối MongoDB (Local MongoDB hoặc MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# ------------------------------------------------------------------------------
# 2. XÁC THỰC, PHÂN QUYỀN RBAC & BẢO MẬT JWT (TUẦN 2)
# ------------------------------------------------------------------------------
# Khóa bí mật ký Access Token (sử dụng chuỗi ngẫu nhiên, dài và phức tạp)
JWT_SECRET=your_super_secret_jwt_access_key_change_me
JWT_EXPIRES_IN=7d

# Khóa bí mật ký Refresh Token để cấp lại token khi hết hạn
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 3. ĐỊA CHỈ CLIENT FRONTEND (CẤU HÌNH CORS)
# ------------------------------------------------------------------------------
# URL của Client Storefront (dành cho Khách hàng)
CLIENT_URL=http://localhost:5173

# URL của Client Admin Dashboard (dành cho Admin & Vendor)
ADMIN_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# 4. DỊCH VỤ CLOUDINARY UPLOAD ẢNH (TUẦN 2 - THÀNH VIÊN D)
# ------------------------------------------------------------------------------
# Cấu hình Cloudinary API để lưu trữ ảnh sản phẩm, ảnh đại diện, banner
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. DỊCH VỤ EMAIL & MÃ QR ĐƠN HÀNG HMAC (TUẦN 4 - THÀNH VIÊN D)
# ------------------------------------------------------------------------------
# Khóa bí mật tạo chữ ký số HMAC-SHA256 cho mã QR tra cứu đơn hàng (chống giả mạo)
HMAC_SECRET=your_super_secret_hmac_key_for_order_qr_tracking

# Cấu hình SMTP gửi email hóa đơn tự động (ví dụ Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="E-Commerce Store" <no-reply@ecommerce.com>

# ------------------------------------------------------------------------------
# 6. CỔNG THANH TOÁN TRỰC TUYẾN VNPAY SANDBOX (TUẦN 5 - LEADER)
# ------------------------------------------------------------------------------
# Mã định danh Merchant tại VNPay Sandbox
VNP_TMN_CODE=2QXUI4J4

# Khóa bí mật checksum HMAC-SHA512 của VNPay Sandbox
VNP_HASH_SECRET=RAHZANVOWZGCLUTNZJNXGUSYDJAEXMGS

# Endpoint cổng thanh toán VNPay Sandbox
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL điều hướng người dùng quay lại Client Storefront sau khi thanh toán
VNP_RETURN_URL=http://localhost:5173/checkout/payment-result
