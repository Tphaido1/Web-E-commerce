# ==========================================
# ENVIRONMENT VARIABLES - ECOMMERCE SERVER
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit file .env lên Git.
# ==========================================

# Cổng chạy server
PORT=5000

# Môi trường chạy: development | production | test
NODE_ENV=development

# Chuỗi kết nối MongoDB (local hoặc Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Khóa bí mật dùng để ký JWT (nên dùng chuỗi ngẫu nhiên dài, phức tạp khi deploy)
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# URL của các Client (dùng để cấu hình CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
