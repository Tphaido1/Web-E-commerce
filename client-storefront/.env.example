# Local development / local production preview only.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Hosting: set VITE_API_BASE_URL in Vercel/Netlify build environment to your
# real deployed HTTPS API ending in /api/v1. npm run build:deploy validates it.
# Every VITE_ value is public frontend configuration; never put merchant secrets here.
