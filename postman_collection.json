            "description": "Xác thực refresh token bằng secret riêng và cấp token mới."
          }
        },
        {
          "name": "POST /auth/logout (REAL)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Yêu cầu access token và xóa refresh token hash trong database."
          }
